# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_toastcraft_2026

# -------------------------------------------------------------
# PERSISTENT DATABASE CONFIGURATION (Optional)
# ToastCraft AI automatically uses a zero-config persistent disk database
# (server/data/toastcraft_db.json) if neither remote DB is specified.
# -------------------------------------------------------------
# Option A: PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/toastcraft

# Option B: MongoDB
# MONGODB_URI=mongodb://localhost:27017/toastcraft

# AI Model Keys (Optional - ToastCraft has built-in smart context generation for 100% offline uptime)
GEMINI_API_KEY=
OPENAI_API_KEY=

# -------------------------------------------------------------
# REAL EMAIL OTP DELIVERY CONFIGURATION
# Choose ONE of the providers below:
# -------------------------------------------------------------

# OPTION 1: Resend API (Recommended modern provider)
# Get a free key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=SpeechFlow AI <onboarding@resend.dev>

# OPTION 2: SMTP (Works with Gmail App Password, Brevo, Mailgun, Amazon SES)
# For Gmail: Use a 16-character App Password generated at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=false

# OPTION 3: SendGrid API
# SENDGRID_API_KEY=
